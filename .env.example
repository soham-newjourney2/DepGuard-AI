# Scanner: osv-api | osv-cli | fixture
SCANNER=osv-api
# Verification: auto | demo-local | off   (mock is tests-only; runs on bundled demos only)
VERIFY_MODE=auto
MAX_UPLOAD_MB=15
MAX_FILES=5000
MAX_UNZIPPED_MB=80
MAX_RATIO=100
JOB_TTL_MIN=60
SCAN_TIMEOUT_S=60
VERIFY_TIMEOUT_S=300
RATE_LIMIT=30/min
# Local-only: AI off, no registry/GitHub/exploit-feed calls, verification disabled; only OSV scans leave
LOCAL_ONLY=false
# Exploit signals: CISA KEV + FIRST EPSS joined on CVE ids (auto|off)
EXPLOIT_SIGNALS=auto
