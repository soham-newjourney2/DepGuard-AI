# Scanner: osv-api | osv-cli | fixture
SCANNER=osv-api
# AI: auto | anthropic | template | off  (auto = anthropic if key set, else template)
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Verification: auto | docker | demo-local | off   (mock is tests-only)
VERIFY_MODE=auto
MAX_UPLOAD_MB=15
MAX_FILES=5000
MAX_UNZIPPED_MB=80
MAX_RATIO=100
JOB_TTL_MIN=60
SCAN_TIMEOUT_S=60
VERIFY_TIMEOUT_S=300
RATE_LIMIT=30/min
